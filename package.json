{
  "name": "archava-monad",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Archava on Monad Testnet - AI avatar access with onchain minute packs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "api": "node server/index.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test server/*.test.mjs scripts/*.test.mjs src/lib/*.test.ts src/components/*.test.ts",
    "test:ui": "node scripts/ux-check.mjs",
    "test:backend": "node scripts/test-backend.mjs",
    "verify:local": "node scripts/verify-local.mjs",
    "verify:artifacts": "node scripts/verify-artifacts.mjs",
    "verify:target": "node scripts/verify-deployment-target.mjs",
    "verify:target:push": "node scripts/verify-deployment-target.mjs push",
    "verify:target:deploy": "node scripts/verify-deployment-target.mjs deploy",
    "verify:target:vercel": "node scripts/verify-deployment-target.mjs vercel",
    "verify:target:railway": "node scripts/verify-deployment-target.mjs railway",
    "verify:target:runtime": "node scripts/verify-deployment-target.mjs runtime",
    "verify:target:contracts": "node scripts/verify-deployment-target.mjs contracts",
    "preflight:readonly": "node scripts/readonly-preflight.mjs",
    "config:check": "node scripts/container-config-smoke.mjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@livekit/components-react": "^2.9.23",
    "@livekit/components-styles": "^1.2.0",
    "@livekit/protocol": "^1.50.4",
    "@privy-io/react-auth": "^3.48.1",
    "@spatius/avatarkit": "^1.3.9",
    "@spatius/avatarkit-rtc": "^1.1.5",
    "ethers": "^6.17.0",
    "livekit-client": "^2.21.0",
    "livekit-server-sdk": "^2.19.1",
    "lucide-react": "^0.462.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.5.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "axe-core": "^4.10.3",
    "playwright": "^1.63.0",
    "typescript": "^5.5.3",
    "vite": "^5.4.1"
  }
}
