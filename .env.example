# Archava Monad Testnet Configuration
# Copy to .env and fill with your deployment-specific values.
# Never put provider credentials in VITE_* variables.

# ============================================================================
# RUNTIME GUARD
# ============================================================================
# Must be explicitly set to "true" to enable API and worker startup.
# This prevents accidental use of wrong configuration.
ARCHAVA_RUNTIME_ENABLED=false

# ============================================================================
# WEB APPLICATION
# ============================================================================
PORT=5002
# Browser origin(s) for CORS, comma-separated for multiple allowed origins
WEB_ORIGIN=http://localhost:5174

# Optional public business CTA target, e.g. an official mailto: or wa.me link.
VITE_BUSINESS_CONTACT_URL=

# ============================================================================
# PERSISTENT STATE
# ============================================================================
# Mount persistent storage here for API key digests and paid minute usage.
# Must be separate from BNB deployment state.
ARCHAVA_STATE_DIR=./data

# ============================================================================
# LIVEKIT CONFIGURATION
# ============================================================================
# LiveKit project must be dedicated to Monad deployment
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Worker/agent name must be deployment-specific to avoid processing BNB rooms
ARCHAVA_AGENT_NAME=archava-monad-host

# Optional for separate local processes; Docker sets the production worker URL.
ARCHAVA_WORKER_HEALTH_URL=

# ============================================================================
# AI/AVATAR PROVIDERS
# ============================================================================
# Gemini for voice agent
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
GEMINI_VOICE=Kore

# Avatar provider: spatius or tavus
AVATAR_PROVIDER=spatius

# Spatius configuration (required when AVATAR_PROVIDER=spatius)
SPATIUS_API_KEY=
# Optional startup fallback for exhausted credits/billing or HTTP 429.
# Must have access to the same SPATIUS_APP_ID and SPATIUS_AVATAR_ID.
SPATIUS_API_KEY_2=
SPATIUS_APP_ID=
SPATIUS_AVATAR_ID=

# Tavus configuration (fallback provider)
TAVUS_API_KEY=
FACE_ID=
PAL_ID=
TAVUS_ENABLED=true

# ============================================================================
# MONAD TESTNET BLOCKCHAIN CONFIGURATION
# ============================================================================
# Chain ID: 10143 (Monad Testnet)
# DO NOT use 97 (BNB Testnet) - runtime guard will reject it
CHAIN_ID=10143

# RPC endpoint - use dedicated provider for production
# Public RPC: https://testnet-rpc.monad.xyz
# Replace with your QuickNode, Dwellir, or other provider endpoint
RPC_URL=

# Rental contract and payment token addresses
# These will be set after S02 deployment, leave empty until then
RENTAL_CONTRACT=
PAYMENT_TOKEN_CONTRACT=
RENTAL_DEPLOYMENT_BLOCK=

# ============================================================================
# PREVIEW MODE (OPTIONAL)
# ============================================================================
# Voice preview for development and demos. Paid access never uses this.
# The anonymous preview has no usage quota: a visitor may start another preview
# as soon as one ends, and two previews may overlap. Availability comes only from
# ENABLE_PREVIEW below.
ENABLE_PREVIEW=false
PREVIEW_SECONDS=120

# ============================================================================
# PRIVY WALLET AUTHENTICATION (TRACK 02 SPONSOR)
# ============================================================================
# Required to enable Privy in the frontend; this App ID is public.
# Vite reads it at startup/build time. Set it in Vercel and Docker builds too.
# Login methods follow the Privy Dashboard. Monad Testnet (10143) and embedded
# EOA creation are configured in src/main.tsx via PrivyProvider.
VITE_PRIVY_APP_ID=
# The current backend authenticates wallet signatures, not Privy access tokens,
# and does not use PRIVY_APP_ID or PRIVY_APP_SECRET. No App Secret is required
# for this frontend integration. Never place secrets in VITE_* variables.
# If a Privy server SDK/REST integration is added later, its App ID and App Secret
# belong only in backend environment variables, with explicit server consumers.
# Custom Google OAuth Client ID/secret belong in the Privy Dashboard, not here.

# ============================================================================
# ENVIO HYPERINDEX (INDEXER SPONSOR)
# ============================================================================
# GraphQL endpoint URL from Envio Cloud deployment of packages/indexer.
# Serves public onchain purchase history (/api/purchases).
ENVIO_GRAPHQL_URL=
ENVIO_API_KEY=

# ============================================================================
# NOTES
# ============================================================================
# - Never commit .env file to version control
# - All secrets must be kept server-side, never in VITE_* variables
# - RPC_URL should use private endpoint with better rate limits
# - Contract addresses are filled after deployment (S02)
# - ARCHAVA_RUNTIME_ENABLED must be "true" after configuration is complete
# - LiveKit URL, API keys, and agent name must match deployment targets
